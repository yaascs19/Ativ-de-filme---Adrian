# GEMINI_API_KEY: Opcional (apenas se usar recursos de IA no futuro)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública do aplicativo
APP_URL="MY_APP_URL"

# SQL SERVER (Somee, Azure SQL ou SQL Server local)
# Preencha na Vercel em Settings -> Environment Variables
SQLSERVER_SERVER="seu-servidor.mssql.somee.com"
SQLSERVER_DATABASE="seu-banco"
SQLSERVER_USER="seu-usuario"
SQLSERVER_PASSWORD="sua-password"
SQLSERVER_PORT="1433"
SQLSERVER_ENCRYPT="false"
